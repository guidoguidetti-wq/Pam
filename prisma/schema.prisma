// PAM — Personal Activity Manager
// Prisma Schema v1.0

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── LOOKUP ────────────────────────────────────────────────

enum TipoVoceListino {
  ORARIO
  GIORNALIERO
  KM
  RIMBORSO
}

enum TipoBudget {
  STIMATO
  CONSUNTIVO
}

enum TipoSpesa {
  KM
  AUTOSTRADA
  MEZZI
  VITTO
  ALLOGGIO
  ALTRO
}

enum PrioritaTodo {
  URGENTE
  ALTA
  MEDIA
  BASSA
}

enum StatoTodo {
  APERTA
  IN_CORSO
  IN_ATTESA
  CHIUSA
}

model TipoAttivita {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  codice      String  @unique @db.VarChar(10)
  descrizione String  @db.VarChar(100)
  attivo      Boolean @default(true)

  listino        Listino[]
  progettoStime  ProgettoStima[]
  progettiTipi   ProgettoTipoAttivita[]
  stimeDettaglio ProgettoStimaDettaglio[]
  attivita       Attivita[]

  @@map("tipo_attivita")
}

// ─── COMMITTENTI ───────────────────────────────────────────

model Committente {
  id             Int      @id @default(autoincrement())
  ragioneSociale String   @map("ragione_sociale") @db.VarChar(200)
  partitaIva     String?  @map("partita_iva") @db.VarChar(20)
  codiceFiscale  String?  @map("codice_fiscale") @db.VarChar(16)
  indirizzo      String?  @db.Text
  email          String?  @db.VarChar(150)
  telefono       String?  @db.VarChar(30)
  note           String?  @db.Text
  attivo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  clienti  Cliente[]
  listino  Listino[]
  progetti Progetto[]
  attivita Attivita[]
  todo     Todo[]

  @@map("committente")
}

// ─── CLIENTI ───────────────────────────────────────────────

model Cliente {
  id             Int      @id @default(autoincrement())
  committenteId  Int      @map("committente_id")
  ragioneSociale String   @map("ragione_sociale") @db.VarChar(200)
  partitaIva     String?  @map("partita_iva") @db.VarChar(20)
  indirizzo      String?  @db.Text
  email          String?  @db.VarChar(150)
  note           String?  @db.Text
  kmTrasferta    Int?     @map("km_trasferta")
  attivo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  committente Committente   @relation(fields: [committenteId], references: [id])
  listino     Listino[]
  progetti    Progetto[]
  attivita    Attivita[]
  todo        Todo[]
  credenziali Credenziale[]

  @@index([committenteId])
  @@map("cliente")
}

// ─── LISTINO ───────────────────────────────────────────────

model Listino {
  id             Int             @id @default(autoincrement())
  committenteId  Int             @map("committente_id")
  clienteId      Int?            @map("cliente_id") // NULL = default committente
  tipoAttivitaId Int?            @map("tipo_attivita_id") @db.SmallInt // NULL = tutti i tipi
  tipoVoce       TipoVoceListino @map("tipo_voce")
  tariffa        Decimal         @db.Decimal(10, 4)
  tariffaKm      Decimal?        @map("tariffa_km") @db.Decimal(10, 4)
  valuta         String          @default("EUR") @db.Char(3)
  oreGiornata    Decimal         @default(8.00) @map("ore_giornata") @db.Decimal(4, 2)
  dataInizio     DateTime        @map("data_inizio") @db.Date
  dataFine       DateTime?       @map("data_fine") @db.Date
  note           String?         @db.Text

  committente  Committente   @relation(fields: [committenteId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  tipoAttivita TipoAttivita? @relation(fields: [tipoAttivitaId], references: [id])

  @@index([committenteId, clienteId, tipoAttivitaId])
  @@map("listino")
}

// ─── PROGETTI ──────────────────────────────────────────────

model Progetto {
  id               Int        @id @default(autoincrement())
  committenteId    Int        @map("committente_id")
  clienteId        Int        @map("cliente_id")
  codice           String?    @db.VarChar(50)
  nome             String     @db.VarChar(200)
  descrizione      String?    @db.Text
  tipoBudget       TipoBudget @default(CONSUNTIVO) @map("tipo_budget")
  dataInizio       DateTime?  @map("data_inizio") @db.Date
  dataFinePrevista DateTime?  @map("data_fine_prevista") @db.Date
  attivo           Boolean    @default(true)
  note             String?    @db.Text
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz

  committente    Committente              @relation(fields: [committenteId], references: [id])
  cliente        Cliente                  @relation(fields: [clienteId], references: [id])
  stime          ProgettoStima[]
  tipiAttivita   ProgettoTipoAttivita[]
  stimeDettaglio ProgettoStimaDettaglio[]
  attivita       Attivita[]
  allegati       Allegato[]

  @@index([committenteId])
  @@index([clienteId])
  @@map("progetto")
}

// Tipi attività ammessi nel progetto (un progetto può contenere più tipi)
model ProgettoTipoAttivita {
  progettoId     Int @map("progetto_id")
  tipoAttivitaId Int @map("tipo_attivita_id") @db.SmallInt

  progetto     Progetto     @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  tipoAttivita TipoAttivita @relation(fields: [tipoAttivitaId], references: [id])

  @@id([progettoId, tipoAttivitaId])
  @@index([tipoAttivitaId])
  @@map("progetto_tipo_attivita")
}

// Dettaglio stime del progetto: tutte le attività (anche erogate da altre persone),
// indipendente dai tipi previsti dal progetto
model ProgettoStimaDettaglio {
  id             Int      @id @default(autoincrement())
  progettoId     Int      @map("progetto_id")
  tipoAttivitaId Int      @map("tipo_attivita_id") @db.SmallInt
  descrizione    String?  @db.Text
  giorni         Decimal  @db.Decimal(8, 2)
  ordine         Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  progetto     Progetto     @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  tipoAttivita TipoAttivita @relation(fields: [tipoAttivitaId], references: [id])

  @@index([progettoId])
  @@index([tipoAttivitaId])
  @@map("progetto_stima_dettaglio")
}

model ProgettoStima {
  id             Int     @id @default(autoincrement())
  progettoId     Int     @map("progetto_id")
  tipoAttivitaId Int     @map("tipo_attivita_id") @db.SmallInt
  giorniStimati  Decimal @map("giorni_stimati") @db.Decimal(8, 2)
  orePerGiorno   Decimal @default(8.00) @map("ore_per_giorno") @db.Decimal(4, 2)

  progetto     Progetto     @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  tipoAttivita TipoAttivita @relation(fields: [tipoAttivitaId], references: [id])

  @@unique([progettoId, tipoAttivitaId])
  @@map("progetto_stima")
}

// ─── ATTIVITÀ (LOG PRINCIPALE) ─────────────────────────────

model Attivita {
  id             BigInt   @id @default(autoincrement())
  dataAttivita   DateTime @map("data_attivita") @db.Date
  oraInizio      DateTime @map("ora_inizio") @db.Time()
  oraFine        DateTime @map("ora_fine") @db.Time()
  // durata_minuti è computed: calcolato in app da oraFine - oraInizio
  committenteId  Int      @map("committente_id")
  clienteId      Int?     @map("cliente_id")
  progettoId     Int?     @map("progetto_id")
  tipoAttivitaId Int      @map("tipo_attivita_id") @db.SmallInt
  descrizione    String?  @db.Text
  noteInterne    String?  @map("note_interne") @db.Text
  fatturabile    Boolean  @default(true)
  oreErogate     Int?     @map("ore_erogate") @db.SmallInt
  prezzoUnitario Decimal? @map("prezzo_unitario") @db.Decimal(10, 4)
  valoreAttivita Decimal? @map("valore_attivita") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  committente  Committente  @relation(fields: [committenteId], references: [id])
  cliente      Cliente?     @relation(fields: [clienteId], references: [id])
  progetto     Progetto?    @relation(fields: [progettoId], references: [id])
  tipoAttivita TipoAttivita @relation(fields: [tipoAttivitaId], references: [id])
  spese        Spesa[]
  allegati     Allegato[]

  @@index([dataAttivita])
  @@index([committenteId, dataAttivita])
  @@index([clienteId])
  @@index([progettoId])
  @@map("attivita")
}

// ─── SPESE ─────────────────────────────────────────────────

model Spesa {
  id                BigInt    @id @default(autoincrement())
  attivitaId        BigInt    @map("attivita_id")
  tipoSpesa         TipoSpesa @map("tipo_spesa")
  descrizione       String?   @db.VarChar(300)
  quantita          Decimal?  @db.Decimal(10, 3) // per KM: numero km
  importoUnitario   Decimal?  @map("importo_unitario") @db.Decimal(10, 4) // €/km
  importoTotale     Decimal   @map("importo_totale") @db.Decimal(10, 2)
  valuta            String    @default("EUR") @db.Char(3)
  dataSpesa         DateTime  @map("data_spesa") @db.Date
  rimborsoRichiesto Boolean   @default(true) @map("rimborso_richiesto")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  attivita Attivita   @relation(fields: [attivitaId], references: [id], onDelete: Cascade)
  allegati Allegato[]

  @@index([attivitaId])
  @@map("spesa")
}

// ─── BACKUP LOG ────────────────────────────────────────────

model BackupLog {
  id            Int      @id @default(autoincrement())
  filename      String   @db.VarChar(255)
  filePath      String?  @map("file_path") @db.VarChar(500)
  fileSizeBytes Int?     @map("file_size_bytes")
  status        String   @default("success") @db.VarChar(20)
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("backup_log")
}

// ─── ALLEGATI ──────────────────────────────────────────────

model Allegato {
  id              BigInt    @id @default(autoincrement())
  spesaId         BigInt?   @map("spesa_id")
  attivitaId      BigInt?   @map("attivita_id")
  progettoId      Int?      @map("progetto_id")
  descrizione     String?   @db.Text
  dataAllegato    DateTime? @map("data_allegato") @db.Date
  nomeFile        String    @map("nome_file") @db.VarChar(255)
  tipoMime        String?   @map("tipo_mime") @db.VarChar(100)
  dimensioneBytes Int?      @map("dimensione_bytes")
  storageKey      String    @map("storage_key") @db.VarChar(500)
  storageUrl      String?   @map("storage_url") @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  spesa    Spesa?    @relation(fields: [spesaId], references: [id], onDelete: Cascade)
  attivita Attivita? @relation(fields: [attivitaId], references: [id], onDelete: Cascade)
  progetto Progetto? @relation(fields: [progettoId], references: [id], onDelete: Cascade)

  @@index([spesaId])
  @@index([attivitaId])
  @@index([progettoId])
  @@map("allegato")
}

// ─── CONTI BANCA ───────────────────────────────────────────

model Ente {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(200)
  nomeNorm  String   @map("nome_norm") @db.VarChar(200)
  categoria String?  @db.VarChar(100)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  movimenti MovimentoBancario[]

  @@unique([nomeNorm])
  @@map("ente")
}

model EnteCategoria {
  id         Int      @id @default(autoincrement())
  categoria  String   @unique @db.VarChar(100)
  inestratto Boolean  @default(true)
  ingrafico  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("enticategorie")
}

model ContoBanca {
  id           Int      @id @default(autoincrement())
  banca        String   @db.VarChar(100)
  numeroConto  String   @map("numero_conto") @db.VarChar(50)
  iban         String?  @db.VarChar(34)
  intestatario String?  @db.VarChar(200)
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  movimenti MovimentoBancario[]

  @@map("conto_banca")
}

model MovimentoBancario {
  id             BigInt    @id @default(autoincrement())
  contoId        Int       @map("conto_id")
  dataOperazione DateTime  @map("data_operazione") @db.Date
  dataValuta     DateTime? @map("data_valuta") @db.Date
  descrizione    String    @db.Text
  enteId         Int?      @map("ente_id")
  importo        Decimal   @db.Decimal(12, 2)
  categoria      String?   @db.VarChar(50)
  stato          String?   @db.VarChar(30)
  hash           String    @map("hash") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  conto ContoBanca @relation(fields: [contoId], references: [id])
  ente  Ente?      @relation(fields: [enteId], references: [id])

  @@unique([contoId, hash])
  @@index([dataOperazione])
  @@index([enteId])
  @@map("movimento_bancario")
}

// ─── TODO ──────────────────────────────────────────────────

model Todo {
  id                BigInt       @id @default(autoincrement())
  titolo            String       @db.VarChar(300)
  descrizione       String?      @db.Text
  priorita          PrioritaTodo @default(MEDIA)
  stato             StatoTodo    @default(APERTA)
  committenteId     Int?         @map("committente_id")
  clienteId         Int?         @map("cliente_id")
  committenteLibero String?      @map("committente_libero") @db.VarChar(200)
  clienteLibero     String?      @map("cliente_libero") @db.VarChar(200)
  scadenza          DateTime?    @db.Date
  note              String?      @db.Text
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  committente Committente? @relation(fields: [committenteId], references: [id])
  cliente     Cliente?     @relation(fields: [clienteId], references: [id])

  @@index([stato, priorita])
  @@index([committenteId])
  @@map("todo")
}

// ─── PASSWORD MANAGER ──────────────────────────────────────

model Credenziale {
  id        Int      @id @default(autoincrement())
  clienteId Int      @map("cliente_id")
  sezione   String   @db.VarChar(200)
  ambiente  String?  @db.VarChar(100)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  cliente Cliente           @relation(fields: [clienteId], references: [id])
  voci    CredenzialeVoce[]

  @@index([clienteId])
  @@map("credenziale")
}

model CredenzialeVoce {
  id            Int      @id @default(autoincrement())
  credenzialeId Int      @map("credenziale_id")
  descrizione   String?  @db.VarChar(500)
  utente        String?  @db.VarChar(500)
  password      String?  @db.VarChar(1000)
  ordine        Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  credenziale Credenziale @relation(fields: [credenzialeId], references: [id], onDelete: Cascade)

  @@index([credenzialeId])
  @@map("credenziale_voce")
}
